                    e.Handled = True
                    Return
                End If

                Dim obj2 As String = text
                Dim num2 As Double = 0.0
                If Double.TryParse(obj2, num2) AndAlso text.IndexOf("."c) < text.Length - 3 Then
                    e.Handled = False
                End If
