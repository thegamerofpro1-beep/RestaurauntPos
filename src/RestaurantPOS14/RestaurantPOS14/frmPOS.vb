        Private Function BuildReplacePayload(billId As Integer, billType As String) As String
            Try
                Dim billTable As String =(If((Equals(billType, "EB")), "RestaurantPOS_BillingInfoEB", (If((Equals(billType, "TA")), "RestaurantPOS_BillingInfoTA", "RestaurantPOS_BillingInfoHD"))))
                Dim linesTable As String =(If((Equals(billType, "EB")), "RestaurantPOS_OrderedProductBillEB", (If((Equals(billType, "TA")), "RestaurantPOS_OrderedProductBillTA", "RestaurantPOS_OrderedProductBillHD"))))
                Using con As System.Data.SqlClient.SqlConnection = New System.Data.SqlClient.SqlConnection(RestaurantPOS14.ConnectionString.cs)
                    con.Open()
                    Dim billNo As String = Nothing
                Dim billDate As System.DateTime = System.DateTime.Now
                Dim currency As String = Nothing
                Dim grandTotal As Decimal = DirectCast(Nothing, System.Decimal)
                Dim customerName As String = Nothing
                Dim taxType As String = Nothing
                Using cmd As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT TOP 1 BillNo, BillDate, CurrencyCode, GrandTotal, CustomerName, TaxType FROM " & billTable & " WHERE Id=@id", con)
                    cmd.Parameters.AddWithValue("@id", billId)
                    Using r As System.Data.SqlClient.SqlDataReader = cmd.ExecuteReader()
                        If r.Read() Then
                            billNo =(If(r.IsDBNull(0), Nothing, r.GetString(CInt((0))).Trim()))
                            billDate =(If(r.IsDBNull(1), System.DateTime.Now, r.GetDateTime(1)))
                            currency =(If(r.IsDBNull(2), Nothing, r.GetString(CInt((2))).Trim()))
                            grandTotal =(If(r.IsDBNull(3), 0D, r.GetDecimal(3)))
                            customerName =(If(r.IsDBNull(4), Nothing, r.GetString(CInt((4))).Trim()))
                            taxType =(If(r.IsDBNull(5), Nothing, r.GetString(CInt((5))).Trim()))
                        End If
                    End Using
                End Using

                Dim supplierName As String = Nothing
                Dim supplierEmail As String = Nothing
                Dim supplierPhone As String = Nothing
                Dim address1 As String = Nothing
                Using cmd2 As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT TOP 1 HotelName, EmailID, ContactNo, AddressLine1 FROM Hotel", con)
                    Using r2 As System.Data.SqlClient.SqlDataReader = cmd2.ExecuteReader()
                        If r2.Read() Then
                            supplierName =(If(r2.IsDBNull(0), Nothing, r2.GetString(CInt((0))).Trim()))
                            supplierEmail =(If(r2.IsDBNull(1), Nothing, r2.GetString(CInt((1))).Trim()))
                            supplierPhone =(If(r2.IsDBNull(2), Nothing, r2.GetString(CInt((2))).Trim()))
                            address1 =(If(r2.IsDBNull(3), Nothing, r2.GetString(CInt((3))).Trim()))
                        End If
                    End Using
                End Using

                Dim sbItems As System.Text.StringBuilder = New System.Text.StringBuilder()
                Using cmd3 As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT Dish, Quantity, Rate, TotalAmount, VATPer, VATAmount, STPer, STAmount FROM " & linesTable & " WHERE BillID=@id", con)
                    cmd3.Parameters.AddWithValue("@id", billId)
                    Using r3 As System.Data.SqlClient.SqlDataReader = cmd3.ExecuteReader()
                        Dim first As Boolean = True
                        While r3.Read()
                            If Not first Then
                                sbItems.Append(","c)
                            End If

                            first = False
                            Dim dish As String =(If(r3.IsDBNull(0), Nothing, r3.GetString(0)))
                            Dim qty As Decimal =(If(r3.IsDBNull(1), 0D, r3.GetDecimal(1)))
                            Dim rate As Decimal =(If(r3.IsDBNull(2), 0D, r3.GetDecimal(2)))
                            Dim total As Decimal =(If(r3.IsDBNull(3), 0D, r3.GetDecimal(3)))
                            Dim vatPer As Decimal =(If(r3.IsDBNull(4), 0D, r3.GetDecimal(4)))
                            Dim vatAmt As Decimal =(If(r3.IsDBNull(5), 0D, r3.GetDecimal(5)))
                            Dim stPer As Decimal =(If(r3.IsDBNull(6), 0D, r3.GetDecimal(6)))
                            Dim stAmt As Decimal =(If(r3.IsDBNull(7), 0D, r3.GetDecimal(7)))
                            sbItems.Append("{""description"":""" & RestaurantPOS14.frmPOS.JsonEscape(dish) & """,""quantity"":" & qty.ToString("0.###") & ",""unitPrice"":" & rate.ToString("0.##") & ",""lineTotal"":" & total.ToString("0.##") & ",""vatRate"":" & vatPer.ToString("0.##") & ",""vatAmount"":" & vatAmt.ToString("0.##") & ",""stRate"":" & stPer.ToString("0.##") & ",""stAmount"":" & stAmt.ToString("0.##") & "}")
                        End While
                    End Using
                End Using

                Dim json As System.Text.StringBuilder = New System.Text.StringBuilder()
                json.Append("{")
                json.Append("""invoiceNumber"":""" & RestaurantPOS14.frmPOS.JsonEscape(billNo) & """,")
                json.Append("""issueDate"":""" & billDate.ToString("o") & """,")
                json.Append("""currency"":""" & RestaurantPOS14.frmPOS.JsonEscape(currency) & """,")
                json.Append("""totalAmount"":" & grandTotal.ToString("0.##") & ",")
                json.Append("""taxType"":""" & RestaurantPOS14.frmPOS.JsonEscape(taxType) & """,")
                json.Append("""supplier"":{""name"":""" & RestaurantPOS14.frmPOS.JsonEscape(supplierName) & """,""email"":""" & RestaurantPOS14.frmPOS.JsonEscape(supplierEmail) & """,""phone"":""" & RestaurantPOS14.frmPOS.JsonEscape(supplierPhone) & """,""address1"":""" & RestaurantPOS14.frmPOS.JsonEscape(address1) & """},")
                json.Append("""buyer"":{""name"":""" & RestaurantPOS14.frmPOS.JsonEscape(customerName) & """},")
                json.Append("""lines"":[" & sbItems.ToString() & "]")
                json.Append("}")
                Return json.ToString()
                End Using
            Catch
            End Try

            Return "{}"
        End Function

        Private Shared Function JsonEscape(s As String) As String
            If String.IsNullOrEmpty(s) Then
                Return String.Empty
            End If

            Return s.Replace(CStr(("\")), CStr(("\\"))).Replace(CStr(("""")), CStr(("\"""))).Replace(CStr((Global.Microsoft.VisualBasic.Constants.vbLf)), CStr(("\n"))).Replace(Global.Microsoft.VisualBasic.Constants.vbCr, "\r")
        End Function

