                RestaurantPOS14.frmPOS.EBaseUrl = settings.BaseUrl
                RestaurantPOS14.frmPOS.EClientId = settings.ClientId
                RestaurantPOS14.frmPOS.EClientSecret = settings.ClientSecret
                RestaurantPOS14.frmPOS.EHttp.Timeout = System.TimeSpan.FromSeconds(settings.RequestTimeoutSeconds)
                If Not String.IsNullOrEmpty(RestaurantPOS14.frmPOS.EBaseUrl) Then
                    RestaurantPOS14.frmPOS.EHttp.BaseAddress = New System.Uri(RestaurantPOS14.frmPOS.EBaseUrl)
                End If
            Catch
            End Try
        End Sub

        Private Async Function AcquireTokenAsync() As System.Threading.Tasks.Task(Of String)
            Try
                If String.IsNullOrEmpty(RestaurantPOS14.frmPOS.EClientId) OrElse String.IsNullOrEmpty(RestaurantPOS14.frmPOS.EClientSecret) Then
                    Return Nothing
                End If

                Dim req As System.Net.Http.HttpRequestMessage = New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, RestaurantPOS14.frmPOS.EBaseUrl & "/oauth/token")
                Dim form As System.Text.StringBuilder = New System.Text.StringBuilder()
                form.Append("grant_type=client_credentials")
                form.Append("&client_id=" & System.Uri.EscapeDataString(RestaurantPOS14.frmPOS.EClientId))
                form.Append("&client_secret=" & System.Uri.EscapeDataString(RestaurantPOS14.frmPOS.EClientSecret))
                req.Content = CType(New System.Net.Http.StringContent(form.ToString(), System.Text.Encoding.UTF8, "application/x-www-form-urlencoded"), System.Net.Http.HttpContent)
                Dim resp As System.Net.Http.HttpResponseMessage = Await RestaurantPOS14.frmPOS.EHttp.SendAsync(req)
                If Not resp.IsSuccessStatusCode Then
                    Return Nothing
                End If

                Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(Await resp.Content.ReadAsStringAsync())
                Return CStr((If(jo("access_token"), jo("token"))))
            Catch
                Return Nothing
            End Try
        End Function

        Private Async Function GetNextQueueAsync(con As System.Data.SqlClient.SqlConnection) As System.Threading.Tasks.Task(Of System.Data.DataRow)
            Using da As System.Data.SqlClient.SqlDataAdapter = New System.Data.SqlClient.SqlDataAdapter("SELECT TOP 1 QueueId,BillId,BillType,Status,Payload FROM [dbo].[EInvoiceQueue] WHERE Status IN ('Pending','CancelPending','ReplacePending') AND (NextAttemptAt IS NULL OR NextAttemptAt<=GETDATE()) ORDER BY QueueId", con)
                Dim dt As System.Data.DataTable = New System.Data.DataTable()
                da.Fill(dt)
                Return If((dt.Rows.Count = 0), Nothing, dt.Rows(0))
            End Using
        End Function

        Private Async Function ProcessEInvoiceQueueAsync() As System.Threading.Tasks.Task
            If Me.einvBusy Then
                Return
            End If

            Me.einvBusy = True
            Try
                Using con As System.Data.SqlClient.SqlConnection = New System.Data.SqlClient.SqlConnection(RestaurantPOS14.ConnectionString.cs)
                    Await con.OpenAsync()
                    Dim row As System.Data.DataRow = Await Me.GetNextQueueAsync(con)
                If row Is Nothing Then
                    Return
                End If

                Dim queueId As Integer = System.Convert.ToInt32(row(0))
                Dim billId As Integer = System.Convert.ToInt32(row(1))
                Dim billType As String = System.Convert.ToString(CObj((row(CInt((2)))))).Trim()
                Dim status As String = System.Convert.ToString(CObj((row(CInt((3)))))).Trim()
                Dim payload As String =(If(row.IsNull(4), Nothing, System.Convert.ToString(row(4))))
                Dim token As String = Await Me.AcquireTokenAsync()
                If Not String.IsNullOrEmpty(token) Then
                    RestaurantPOS14.frmPOS.EHttp.DefaultRequestHeaders.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token)
                End If

                If String.IsNullOrEmpty(token) AndAlso (String.IsNullOrEmpty(RestaurantPOS14.frmPOS.EClientId) OrElse String.IsNullOrEmpty(RestaurantPOS14.frmPOS.EClientSecret)) Then
                    Dim table As String = GetEInvoiceBillingTable(billType)
                    Dim uinSim As String = billType & "-" & billId.ToString() & "-" & System.DateTime.Now.ToString("yyyyMMddHHmmss")
                    Dim qrSim As String = "https://example.com/qr/" & System.Uri.EscapeDataString(uinSim)
                    Using upSimulation As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("UPDATE " & table & " SET EInvoiceStatus='Validated', LastSyncedAt=GETDATE(), UIN=@u, QRUrl=@q WHERE Id=@id", con)
                        upSimulation.Parameters.AddWithValue("@id", billId)
                        upSimulation.Parameters.AddWithValue("@u", If((CObj(uinSim)), (CObj(System.DBNull.Value))))
                        upSimulation.Parameters.AddWithValue("@q", If((CObj(qrSim)), (CObj(System.DBNull.Value))))
                        Await upSimulation.ExecuteNonQueryAsync()
                    End Using

                    Await Me.UpdateQueueStatusAsync(con, queueId, "Validated", Nothing)
                    Return
                End If

                If Equals(status, "CancelPending") Then
                    Dim uin As String = Await Me.GetUINAsync(con, billId, billType)
                    If String.IsNullOrEmpty(uin) Then
                        Await Me.MarkErrorAsync(con, queueId, "Missing UIN", 300)
                        Return
                    End If

                    Dim req As System.Net.Http.HttpRequestMessage = New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, RestaurantPOS14.frmPOS.EBaseUrl & "/einvoice/" & System.Uri.EscapeDataString(uin) & "/cancel")
                    req.Content = CType(New System.Net.Http.StringContent(If(payload, String.Empty), System.Text.Encoding.UTF8, "text/plain"), System.Net.Http.HttpContent)
                    Dim resp As System.Net.Http.HttpResponseMessage = Await RestaurantPOS14.frmPOS.EHttp.SendAsync(req)
                    If resp.IsSuccessStatusCode Then
                        Await Me.UpdateQueueStatusAsync(con, queueId, "Cancelled", Nothing)
                        Dim cancelTable As String = GetEInvoiceBillingTable(billType)
                        Using upCancel As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("UPDATE " & cancelTable & " SET EInvoiceStatus='Cancelled', LastSyncedAt=GETDATE() WHERE Id=@id", con)
                            upCancel.Parameters.AddWithValue("@id", billId)
                            Await upCancel.ExecuteNonQueryAsync()
                        End Using
                    Else
                        Await Me.MarkErrorAsync(con, queueId, "HTTP " & resp.StatusCode.ToString(), 600)
                    End If

                    Return
                End If

                Dim submissionId As String
                Dim qrUrl As String
                Dim newUIN As String
                If Equals(status, "ReplacePending") Then
                    Dim uin2 As String = Await Me.GetUINAsync(con, billId, billType)
                    If String.IsNullOrEmpty(uin2) Then
                        Await Me.MarkErrorAsync(con, queueId, "Missing UIN", 300)
                        Return
                    End If

                    Dim req2 As System.Net.Http.HttpRequestMessage = New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, RestaurantPOS14.frmPOS.EBaseUrl & "/einvoice/" & System.Uri.EscapeDataString(uin2) & "/replace")
                    req2.Content = CType(New System.Net.Http.StringContent(If(payload, "{}"), System.Text.Encoding.UTF8, "application/json"), System.Net.Http.HttpContent)
                    Dim resp2 As System.Net.Http.HttpResponseMessage = Await RestaurantPOS14.frmPOS.EHttp.SendAsync(req2)
                    If resp2.IsSuccessStatusCode Then
                        Dim body As String = Await resp2.Content.ReadAsStringAsync()
                        newUIN = Nothing
                        qrUrl = Nothing
                        submissionId = Nothing
                        Try
                            Dim jo As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(body)
                            Dim dataObject As Newtonsoft.Json.Linq.JObject = TryCast(jo("data"), Newtonsoft.Json.Linq.JObject)
                            newUIN = jo.Value(Of String)("UIN")
                            If String.IsNullOrEmpty(newUIN) Then newUIN = jo.Value(Of String)("uin")
                            If String.IsNullOrEmpty(newUIN) AndAlso dataObject IsNot Nothing Then newUIN = dataObject.Value(Of String)("uin")
                            qrUrl = jo.Value(Of String)("QRUrl")
                            If String.IsNullOrEmpty(qrUrl) Then qrUrl = jo.Value(Of String)("qrUrl")
                            If String.IsNullOrEmpty(qrUrl) AndAlso dataObject IsNot Nothing Then qrUrl = dataObject.Value(Of String)("qrUrl")
                            If String.IsNullOrEmpty(qrUrl) AndAlso dataObject IsNot Nothing Then qrUrl = dataObject.Value(Of String)("qr")
                            submissionId = jo.Value(Of String)("submissionId")
                            If String.IsNullOrEmpty(submissionId) AndAlso dataObject IsNot Nothing Then submissionId = dataObject.Value(Of String)("submissionId")
                        Catch
                        End Try

                        Await Me.UpdateQueueStatusAsync(con, queueId, "Replaced", submissionId)
                        Dim replaceTable As String = GetEInvoiceBillingTable(billType)
                        Using upReplace As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("UPDATE " & replaceTable & " SET EInvoiceStatus='Validated', LastSyncedAt=GETDATE(), UIN=@u, QRUrl=@q, ApiSubmissionId=@s WHERE Id=@id", con)
                            upReplace.Parameters.AddWithValue("@id", billId)
                            upReplace.Parameters.AddWithValue("@u", If((CObj(newUIN)), (CObj(System.DBNull.Value))))
                            upReplace.Parameters.AddWithValue("@q", If((CObj(qrUrl)), (CObj(System.DBNull.Value))))
                            upReplace.Parameters.AddWithValue("@s", If((CObj(submissionId)), (CObj(System.DBNull.Value))))
                            Await upReplace.ExecuteNonQueryAsync()
                        End Using
                    Else
                        Await Me.MarkErrorAsync(con, queueId, "HTTP " & resp2.StatusCode.ToString(), 600)
                    End If

                    Return
                End If

                Dim payloadS As String = Await Me.BuildPayloadAsync(con, billId, billType)
                Dim reqS As System.Net.Http.HttpRequestMessage = New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, RestaurantPOS14.frmPOS.EBaseUrl & "/einvoice/submit")
                reqS.Content = CType(New System.Net.Http.StringContent(payloadS, System.Text.Encoding.UTF8, "application/json"), System.Net.Http.HttpContent)
                Dim respS As System.Net.Http.HttpResponseMessage = Await RestaurantPOS14.frmPOS.EHttp.SendAsync(reqS)
                If respS.StatusCode < System.Net.HttpStatusCode.OK OrElse respS.StatusCode >= System.Net.HttpStatusCode.MultipleChoices Then
                    Await Me.MarkErrorAsync(con, queueId, "HTTP " & respS.StatusCode.ToString(), 60)
                    Return
                End If

                Dim body2 As String = Await respS.Content.ReadAsStringAsync()
                submissionId = Nothing
                qrUrl = Nothing
                newUIN = Nothing
                Try
                    Dim jo2 As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(body2)
                    Dim dataObject As Newtonsoft.Json.Linq.JObject = TryCast(jo2("data"), Newtonsoft.Json.Linq.JObject)
                    submissionId = jo2.Value(Of String)("UIN")
                    If String.IsNullOrEmpty(submissionId) Then submissionId = jo2.Value(Of String)("uin")
                    If String.IsNullOrEmpty(submissionId) AndAlso dataObject IsNot Nothing Then submissionId = dataObject.Value(Of String)("uin")
                    qrUrl = jo2.Value(Of String)("QRUrl")
                    If String.IsNullOrEmpty(qrUrl) Then qrUrl = jo2.Value(Of String)("qrUrl")
                    If String.IsNullOrEmpty(qrUrl) AndAlso dataObject IsNot Nothing Then qrUrl = dataObject.Value(Of String)("qrUrl")
                    If String.IsNullOrEmpty(qrUrl) AndAlso dataObject IsNot Nothing Then qrUrl = dataObject.Value(Of String)("qr")
                    newUIN = jo2.Value(Of String)("submissionId")
                    If String.IsNullOrEmpty(newUIN) AndAlso dataObject IsNot Nothing Then newUIN = dataObject.Value(Of String)("submissionId")
                Catch
                End Try

                Await Me.UpdateQueueStatusAsync(con, queueId, "Validated", newUIN)
                Dim validatedTable As String = GetEInvoiceBillingTable(billType)
                Using up2 As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("UPDATE " & validatedTable & " SET EInvoiceStatus='Validated', LastSyncedAt=GETDATE(), UIN=@u, QRUrl=@q, ApiSubmissionId=@s WHERE Id=@id", con)
                    up2.Parameters.AddWithValue("@id", billId)
                    up2.Parameters.AddWithValue("@u", If((CObj(submissionId)), (CObj(System.DBNull.Value))))
                    up2.Parameters.AddWithValue("@q", If((CObj(qrUrl)), (CObj(System.DBNull.Value))))
                    up2.Parameters.AddWithValue("@s", If((CObj(newUIN)), (CObj(System.DBNull.Value))))
                    Await up2.ExecuteNonQueryAsync()
                End Using
                End Using
            Catch __unusedException1__ As System.Exception
            Finally
                Me.einvBusy = False
                Me.RefreshEInvoiceStatusUI()
            End Try
        End Function

        Private Async Function GetUINAsync(con As System.Data.SqlClient.SqlConnection, billId As Integer, billType As String) As System.Threading.Tasks.Task(Of String)
            Dim table As String =(If((Equals(billType, "EB")), "RestaurantPOS_BillingInfoEB", (If((Equals(billType, "TA")), "RestaurantPOS_BillingInfoTA", "RestaurantPOS_BillingInfoHD"))))
            Using cmd As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT UIN FROM " & table & " WHERE Id=@id", con)
                cmd.Parameters.AddWithValue("@id", billId)
                Dim o As Object = Await cmd.ExecuteScalarAsync()
                Return If((o Is Nothing OrElse TypeOf o Is System.DBNull), Nothing, System.Convert.ToString(o))
            End Using
        End Function

        Private Async Function BuildPayloadAsync(con As System.Data.SqlClient.SqlConnection, billId As Integer, billType As String) As System.Threading.Tasks.Task(Of String)
            Dim billTable As String = GetEInvoiceBillingTable(billType)
            Dim linesTable As String
            Select Case billType
                Case "HD"
                    linesTable = "RestaurantPOS_OrderedProductBillHD"
                Case "TA"
                    linesTable = "RestaurantPOS_OrderedProductBillTA"
                Case "EB"
                    linesTable = "RestaurantPOS_OrderedProductBillEB"
                Case Else
                    linesTable = "RestaurantPOS_OrderedProductBillKOT"
            End Select
            Dim billNo As String = Nothing
            Dim billDate As System.DateTime = System.DateTime.Now
            Dim currency As String = Nothing
            Dim grandTotal As Decimal = DirectCast(Nothing, System.Decimal)
            Dim customerName As String = Nothing
            Dim taxType As String = Nothing
            Using cmd As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT TOP 1 BillNo, BillDate, CurrencyCode, GrandTotal, CustomerName, TaxType FROM " & billTable & " WHERE Id=@id", con)
                cmd.Parameters.AddWithValue("@id", billId)
                Using r As System.Data.SqlClient.SqlDataReader = Await cmd.ExecuteReaderAsync()
                    If Await r.ReadAsync() Then
                        billNo =(If(r.IsDBNull(0), Nothing, r.GetString(CInt((0))).Trim()))
                        billDate =(If(r.IsDBNull(1), System.DateTime.Now, r.GetDateTime(1)))
                        currency =(If(r.IsDBNull(2), Nothing, r.GetString(CInt((2))).Trim()))
                        grandTotal =(If(r.IsDBNull(3), 0D, r.GetDecimal(3)))
                        customerName =(If(r.IsDBNull(4), Nothing, r.GetString(CInt((4))).Trim()))
                        taxType =(If(r.IsDBNull(5), Nothing, r.GetString(CInt((5))).Trim()))
                    End If
                End Using
            End Using

            Dim supplierName As String = Nothing
            Dim supplierEmail As String = Nothing
            Dim supplierPhone As String = Nothing
            Dim address1 As String = Nothing
            Using cmd As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT TOP 1 HotelName, EmailID, ContactNo, AddressLine1 FROM Hotel", con)
                Using r As System.Data.SqlClient.SqlDataReader = Await cmd.ExecuteReaderAsync()
                    If Await r.ReadAsync() Then
                        supplierName =(If(r.IsDBNull(0), Nothing, r.GetString(CInt((0))).Trim()))
                        supplierEmail =(If(r.IsDBNull(1), Nothing, r.GetString(CInt((1))).Trim()))
                        supplierPhone =(If(r.IsDBNull(2), Nothing, r.GetString(CInt((2))).Trim()))
                        address1 =(If(r.IsDBNull(3), Nothing, r.GetString(CInt((3))).Trim()))
                    End If
                End Using
            End Using

            Dim sbItems As System.Text.StringBuilder = New System.Text.StringBuilder()
            Using cmd As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT Dish, Quantity, Rate, TotalAmount, VATPer, VATAmount, STPer, STAmount FROM " & linesTable & " WHERE BillID=@id", con)
                cmd.Parameters.AddWithValue("@id", billId)
                Using r As System.Data.SqlClient.SqlDataReader = Await cmd.ExecuteReaderAsync()
                    Dim first As Boolean = True
                    While Await r.ReadAsync()
                        If Not first Then
                            sbItems.Append(","c)
                        End If

                        first = False
                        Dim dish As String =(If(r.IsDBNull(0), Nothing, r.GetString(0)))
                        Dim qty As Decimal =(If(r.IsDBNull(1), 0D, r.GetDecimal(1)))
                        Dim rate As Decimal =(If(r.IsDBNull(2), 0D, r.GetDecimal(2)))
                        Dim total As Decimal =(If(r.IsDBNull(3), 0D, r.GetDecimal(3)))
                        Dim vatPer As Decimal =(If(r.IsDBNull(4), 0D, r.GetDecimal(4)))
                        Dim vatAmt As Decimal =(If(r.IsDBNull(5), 0D, r.GetDecimal(5)))
                        Dim stPer As Decimal =(If(r.IsDBNull(6), 0D, r.GetDecimal(6)))
                        Dim stAmt As Decimal =(If(r.IsDBNull(7), 0D, r.GetDecimal(7)))
                        sbItems.Append("{""description"":""" & RestaurantPOS14.frmPOS.JsonEscape(dish) & """,""quantity"":" & qty.ToString("0.###") & ",""unitPrice"":" & rate.ToString("0.##") & ",""lineTotal"":" & total.ToString("0.##") & ",""vatRate"":" & vatPer.ToString("0.##") & ",""vatAmount"":" & vatAmt.ToString("0.##") & ",""stRate"":" & stPer.ToString("0.##") & ",""stAmount"":" & stAmt.ToString("0.##") & "}")
                    End While
                End Using
            End Using

            Dim json As System.Text.StringBuilder = New System.Text.StringBuilder()
            json.Append("{")
            json.Append("""invoiceNumber"":""" & RestaurantPOS14.frmPOS.JsonEscape(billNo) & """,")
            json.Append("""issueDate"":""" & billDate.ToString("o") & """,")
            json.Append("""currency"":""" & RestaurantPOS14.frmPOS.JsonEscape(currency) & """,")
            json.Append("""totalAmount"":" & grandTotal.ToString("0.##") & ",")
            json.Append("""taxType"":""" & RestaurantPOS14.frmPOS.JsonEscape(taxType) & """,")
            json.Append("""supplier"":{""name"":""" & RestaurantPOS14.frmPOS.JsonEscape(supplierName) & """,""email"":""" & RestaurantPOS14.frmPOS.JsonEscape(supplierEmail) & """,""phone"":""" & RestaurantPOS14.frmPOS.JsonEscape(supplierPhone) & """,""address1"":""" & RestaurantPOS14.frmPOS.JsonEscape(address1) & """},")
            json.Append("""buyer"":{""name"":""" & RestaurantPOS14.frmPOS.JsonEscape(customerName) & """},")
            json.Append("""lines"":[" & sbItems.ToString() & "]")
            json.Append("}")
            Return json.ToString()
        End Function

        Private Async Function MarkErrorAsync(con As System.Data.SqlClient.SqlConnection, queueId As Integer, [error] As String, backoffSeconds As Integer) As System.Threading.Tasks.Task
            Using up As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("UPDATE [dbo].[EInvoiceQueue] SET Status='Pending', LastError=@e, AttemptCount=AttemptCount+1, NextAttemptAt=DATEADD(second,@b,GETDATE()) WHERE QueueId=@id", con)
                up.Parameters.AddWithValue("@e", If((CObj([error])), (CObj(System.DBNull.Value))))
                up.Parameters.AddWithValue("@b", backoffSeconds)
                up.Parameters.AddWithValue("@id", queueId)
                Await up.ExecuteNonQueryAsync()
            End Using
        End Function

        Private Async Function UpdateQueueStatusAsync(con As System.Data.SqlClient.SqlConnection, queueId As Integer, status As String, submissionId As String) As System.Threading.Tasks.Task
            Using up As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("UPDATE [dbo].[EInvoiceQueue] SET Status=@st, AttemptCount=AttemptCount+1, LastError=NULL, SubmissionId=@s, NextAttemptAt=GETDATE() WHERE QueueId=@id", con)
                up.Parameters.AddWithValue("@id", queueId)
                up.Parameters.AddWithValue("@st", status)
                up.Parameters.AddWithValue("@s", If((CObj(submissionId)), (CObj(System.DBNull.Value))))
                Await up.ExecuteNonQueryAsync()
            End Using
        End Function

        Public Sub txtTADiscountPer_KeyPress(sender As Object, e As System.Windows.Forms.KeyPressEventArgs)
            Dim keyChar As Char = e.KeyChar
            If Char.IsControl(keyChar) Then
                Return
            End If

            If Char.IsDigit(keyChar) OrElse keyChar = "."c Then
                Dim text As String = Me.txtTADiscountPer.Text
                Dim selectionStart As Integer = Me.txtTADiscountPer.SelectionStart
                Dim selectionLength As Integer = Me.txtTADiscountPer.SelectionLength
                text = text.Substring(0, selectionStart) & Microsoft.VisualBasic.CompilerServices.Conversions.ToString(keyChar) & text.Substring(selectionStart + selectionLength)
                Dim obj As String = text
                Dim num As Integer = 0
                If Integer.TryParse(obj, num) AndAlso text.Length > 16 Then
                    e.Handled = True
                    Return
                End If

                Dim obj2 As String = text
                Dim num2 As Double = 0.0
                If Double.TryParse(obj2, num2) AndAlso text.IndexOf("."c) < text.Length - 3 Then
                    e.Handled = False
                End If
            Else
                e.Handled = True
            End If
        End Sub

