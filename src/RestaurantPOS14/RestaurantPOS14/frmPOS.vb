        Private Sub UpdateEInvoiceStatus(billId As Integer, billType As String, lblStatus As System.Windows.Forms.Label, lblError As System.Windows.Forms.Label)
            Try
                If billId <= 0 Then
                    lblStatus.Text = "Status:"
                    lblError.Text = ""
                    Return
                End If

                Dim table As String =(If((Equals(billType, "EB")), "RestaurantPOS_BillingInfoEB", (If((Equals(billType, "TA")), "RestaurantPOS_BillingInfoTA", "RestaurantPOS_BillingInfoHD"))))
                Dim status As String = ""
                Using con As System.Data.SqlClient.SqlConnection = New System.Data.SqlClient.SqlConnection(RestaurantPOS14.ConnectionString.cs)
                    con.Open()
                    Using cmd As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT EInvoiceStatus FROM " & table & " WHERE Id=@id", con)
                        cmd.Parameters.AddWithValue("@id", billId)
                        Dim o As Object = cmd.ExecuteScalar()
                        status =(If((o Is Nothing OrElse TypeOf o Is System.DBNull), "", System.Convert.ToString(o)))
                    End Using

                    Using cmd2 As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT TOP 1 LastError FROM [dbo].[EInvoiceQueue] WHERE BillId=@id AND BillType=@t ORDER BY QueueId DESC", con)
                        cmd2.Parameters.AddWithValue("@id", billId)
                        cmd2.Parameters.AddWithValue("@t", billType)
                        Dim o2 As Object = cmd2.ExecuteScalar()
                        lblError.Text =(If((o2 Is Nothing OrElse TypeOf o2 Is System.DBNull), "", System.Convert.ToString(o2)))
                    End Using
                End Using

                lblStatus.Text = "Status: " & status
                If Not String.IsNullOrEmpty(lblError.Text) Then
                    lblStatus.ForeColor = System.Drawing.Color.Red
                ElseIf String.Equals(status, "Validated", System.StringComparison.OrdinalIgnoreCase) OrElse String.Equals(status, "Valid", System.StringComparison.OrdinalIgnoreCase) Then
                    lblStatus.ForeColor = System.Drawing.Color.Green
                ElseIf String.Equals(status, "Invalid", System.StringComparison.OrdinalIgnoreCase) Then
                    lblStatus.ForeColor = System.Drawing.Color.Red
                ElseIf String.Equals(status, "Submitted", System.StringComparison.OrdinalIgnoreCase) Then
                    lblStatus.ForeColor = System.Drawing.Color.SteelBlue
                ElseIf String.Equals(status, "Cancelled", System.StringComparison.OrdinalIgnoreCase) Then
                    lblStatus.ForeColor = System.Drawing.Color.Gray
                ElseIf Not String.IsNullOrEmpty(status) Then
                    lblStatus.ForeColor = System.Drawing.Color.DarkOrange
                Else
                    lblStatus.ForeColor = System.Drawing.Color.Black
                End If

                If Me.einvTip IsNot Nothing Then
                    Me.einvTip.SetToolTip(lblStatus, If(String.IsNullOrEmpty(lblError.Text), status, (status & Global.Microsoft.VisualBasic.Constants.vbLf & lblError.Text)))
                    Me.einvTip.SetToolTip(lblError, lblError.Text)
                End If
            Catch
            End Try
        End Sub

