        Private Shared Function GetEInvoiceBillingTable(billType As String) As String
            Select Case billType
                Case "HD"
                    Return "RestaurantPOS_BillingInfoHD"
                Case "TA"
                    Return "RestaurantPOS_BillingInfoTA"
                Case "EB"
                    Return "RestaurantPOS_BillingInfoEB"
                Case Else
                    Return "RestaurantPOS_BillingInfoKOT"
            End Select
        End Function

        Private Function BuildEInvoiceExtra(billId As Integer, billType As String, <Out> ByRef uin As String, <Out> ByRef qrUrl As String) As System.Data.DataTable
            uin = ""
            qrUrl = ""
            Try
                Dim table As String = GetEInvoiceBillingTable(billType)
                Using con As System.Data.SqlClient.SqlConnection = New System.Data.SqlClient.SqlConnection(RestaurantPOS14.ConnectionString.cs)
                    con.Open()
                    Using cmd As System.Data.SqlClient.SqlCommand = New System.Data.SqlClient.SqlCommand("SELECT UIN, QRUrl FROM " & table & " WHERE Id=@id", con)
                        cmd.Parameters.AddWithValue("@id", billId)
                        Using r As System.Data.SqlClient.SqlDataReader = cmd.ExecuteReader()
                            If r.Read() Then
                                uin =(If(r.IsDBNull(0), "", r.GetString(CInt((0))).Trim()))
                                qrUrl =(If(r.IsDBNull(1), "", r.GetString(CInt((1))).Trim()))
                            End If
                        End Using
                    End Using
                End Using

                Dim dt As System.Data.DataTable = New System.Data.DataTable("EInvoiceExtra")
                dt.Columns.Add("UIN", GetType(String))
                dt.Columns.Add("QRImage", GetType(Byte()))
                Dim qrBytes As Byte() = Nothing
                If Not String.IsNullOrEmpty(qrUrl) Then
                    Try
                        Dim bmp As System.Drawing.Bitmap = New MessagingToolkit.QRCode.Codec.QRCodeEncoder().Encode(qrUrl)
                        Using ms As System.IO.MemoryStream = New System.IO.MemoryStream()
                            bmp.Save(ms, System.Drawing.Imaging.ImageFormat.Png)
                            qrBytes = ms.ToArray()
                        End Using
                    Catch
                    End Try
                End If

                Dim row As System.Data.DataRow = dt.NewRow()
                row("UIN") = If(uin, "")
                row("QRImage") = If((CObj(qrBytes)), (CObj(System.DBNull.Value)))
                dt.Rows.Add(row)
                Return dt
            Catch
            End Try

            Return Nothing
        End Function

