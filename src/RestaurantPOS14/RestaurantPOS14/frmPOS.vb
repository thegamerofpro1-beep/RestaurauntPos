                    RestaurantPOS14.ModFunc.LedgerSave(System.DateTime.Today, "Sales A/c", Me.lblBillNo1.Text, "Sales Invoice", 0D, New Decimal(Microsoft.VisualBasic.Conversion.Val(Me.txtGrandTotal1.Text) * Microsoft.VisualBasic.Conversion.Val(Me.txtExchangeRate.Text)), "", "Cash")
