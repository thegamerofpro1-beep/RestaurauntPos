        Public Sub txtContactNo_TextChanged(sender As Object, e As System.EventArgs)
            Try
                If Me.txtContactNo.Text.Length >= 6 Then
                    RestaurantPOS14.ModClasses.con = New System.Data.SqlClient.SqlConnection(RestaurantPOS14.ConnectionString.cs)
                    RestaurantPOS14.ModClasses.con.Open()
                    RestaurantPOS14.ModClasses.cmd = RestaurantPOS14.ModClasses.con.CreateCommand()
                    RestaurantPOS14.ModClasses.cmd.CommandText = "SELECT distinct RTRIM(Customername),RTRIM(Address) from RestaurantPOS_BillingInfoHD where ContactNo=@d1 Union Select distinct RTRIM(Customername),RTRIM(Address) from HDCustomer where ContactNo=@d1"
                    RestaurantPOS14.ModClasses.cmd.Parameters.AddWithValue("@d1", Me.txtContactNo.Text)
                    RestaurantPOS14.ModClasses.rdr = RestaurantPOS14.ModClasses.cmd.ExecuteReader()
                    If RestaurantPOS14.ModClasses.rdr.Read() Then
                        Me.txtCustomerName.Text = RestaurantPOS14.ModClasses.rdr.GetValue(CInt((0))).ToString()
                        Me.txtAddress.Text = RestaurantPOS14.ModClasses.rdr.GetValue(CInt((1))).ToString()
                    End If

                    If RestaurantPOS14.ModClasses.rdr IsNot Nothing Then
