        Public Sub IsEnabledCallerID()
            Try
                Me.txtTillID.Text = System.Net.Dns.GetHostName()
                RestaurantPOS14.ModClasses.con = New System.Data.SqlClient.SqlConnection(RestaurantPOS14.ConnectionString.cs)
                RestaurantPOS14.ModClasses.con.Open()
                RestaurantPOS14.ModClasses.cmd = New System.Data.SqlClient.SqlCommand("SELECT RTRIM(CallerIDPort) from POSprinterSetting where TillID=@d1 and CallerID='Yes'")
                RestaurantPOS14.ModClasses.cmd.Parameters.AddWithValue("@d1", Me.txtTillID.Text)
                RestaurantPOS14.ModClasses.cmd.Connection = RestaurantPOS14.ModClasses.con
                RestaurantPOS14.ModClasses.rdr = RestaurantPOS14.ModClasses.cmd.ExecuteReader()
                If RestaurantPOS14.ModClasses.rdr.Read() Then
                    Me.lblCustomer.Visible = True
                    Me.btnOkay.Visible = True
                    Me.btnReset.Visible = True
                    Me.Timer5.Start()
                Else
                    Me.lblCustomer.Visible = False
                    Me.btnOkay.Visible = False
                    Me.btnReset.Visible = False
                    Me.Timer5.[Stop]()
                End If
            Catch ex As System.Exception
                Call System.Windows.Forms.MessageBox.Show(ex.Message, "Error", System.Windows.Forms.MessageBoxButtons.OK, System.Windows.Forms.MessageBoxIcon.Hand)
            End Try
        End Sub

