        Public Sub TabControl1_SelectedIndexChanged(sender As Object, e As System.EventArgs)
            If Me.TabControl1.SelectedIndex = 0 Then
                Me.Reset()
                Me.GetTaxType()
                Me.lblOrderNo.Visible = True
                Me.lblOD.Visible = True
            End If

            If Me.TabControl1.SelectedIndex = 1 Then
                If Me.SkipResetOnTabChange Then
                    Me.SkipResetOnTabChange = False
                Else
                    Me.Reset1()
                End If

                Me.lblOrderNo.Visible = False
                Me.lblOD.Visible = False
                Me.GetTaxType()
            End If

            If Me.TabControl1.SelectedIndex = 2 Then
                Me.lblOrderNo.Visible = True
                Me.lblOD.Visible = True
                Me.Reset2()
                Me.GetTaxType()
            End If

            If Me.TabControl1.SelectedIndex = 3 Then
                Me.lblOrderNo.Visible = True
                Me.lblOD.Visible = True
                Me.Reset3()
                Me.GetTaxType()
            End If

            If Me.TabControl1.SelectedIndex = 4 Then
                Me.lblOrderNo.Visible = True
                Me.lblOD.Visible = True
                Me.Reset4()
                Me.GetTaxType()
            End If

            If Me.TabControl1.SelectedIndex = 5 Then
                Me.lblOrderNo.Visible = False
                Me.lblOD.Visible = False
            End If
        End Sub

