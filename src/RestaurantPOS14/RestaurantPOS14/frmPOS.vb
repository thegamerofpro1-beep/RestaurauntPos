        Public Sub Timer5_Tick(sender As Object, e As System.EventArgs)
            Dim matchCollection As System.Text.RegularExpressions.MatchCollection = New System.Text.RegularExpressions.Regex(CStr(("\(?\d{3}\)?-? *\d{3}-? *-?\d{2,4}")), CType((System.Text.RegularExpressions.RegexOptions.IgnoreCase Or System.Text.RegularExpressions.RegexOptions.Compiled), System.Text.RegularExpressions.RegexOptions)).Matches(Me.txtInfo.Text)
            For Each match As System.Text.RegularExpressions.Match In matchCollection
                Me.txtPhoneNo.Text = match.Value.ToString()
                RestaurantPOS14.ModClasses.con = New System.Data.SqlClient.SqlConnection(RestaurantPOS14.ConnectionString.cs)
                RestaurantPOS14.ModClasses.con.Open()
                RestaurantPOS14.ModClasses.cmd = RestaurantPOS14.ModClasses.con.CreateCommand()
                RestaurantPOS14.ModClasses.cmd.CommandText = "SELECT distinct RTRIM(Customername) from RestaurantPOS_BillingInfoHD where ContactNo=@d1 Union Select distinct RTRIM(Customername) from HDCustomer where ContactNo=@d1"
                RestaurantPOS14.ModClasses.cmd.Parameters.AddWithValue("@d1", Me.txtPhoneNo.Text)
                RestaurantPOS14.ModClasses.rdr = RestaurantPOS14.ModClasses.cmd.ExecuteReader()
                If RestaurantPOS14.ModClasses.rdr.Read() Then
                    Me.lblCustomer.Text = RestaurantPOS14.ModClasses.rdr.GetValue(CInt((0))).ToString() & " is calling..."
                Else
                    Me.lblCustomer.Text = "Unknown person is calling..."
                End If

                If RestaurantPOS14.ModClasses.rdr IsNot Nothing Then
                    RestaurantPOS14.ModClasses.rdr.Close()
                End If

                If RestaurantPOS14.ModClasses.con.State = System.Data.ConnectionState.Open Then
                    RestaurantPOS14.ModClasses.con.Close()
                End If
            Next
        End Sub

